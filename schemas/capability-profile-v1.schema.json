{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-project-os.org/schemas/capability-profile-v1.schema.json",
  "title": "Agent Project OS capability profile v1",
  "type": "object",
  "required": ["protocol_version", "profile_id", "agent_id", "capabilities", "updated_at"],
  "properties": {
    "$schema": {"type": "string"},
    "protocol_version": {"$ref": "common-v1.schema.json#/$defs/protocolVersion"},
    "profile_id": {"$ref": "common-v1.schema.json#/$defs/id"},
    "agent_id": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "items": {"type": "object"}},
    "updated_at": {"$ref": "common-v1.schema.json#/$defs/timestamp"}
  },
  "additionalProperties": false
}
