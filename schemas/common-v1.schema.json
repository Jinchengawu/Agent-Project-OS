{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-project-os.org/schemas/common-v1.schema.json",
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{1,127}$"},
    "protocolVersion": {"const": "1.0"},
    "timestamp": {"type": "string", "format": "date-time"},
    "runtimeIdentity": {
      "type": "object",
      "required": ["runtime", "client_version"],
      "properties": {
        "runtime": {"type": "string", "minLength": 1},
        "client_version": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "provider_hint": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "artifactIdentity": {
      "type": "object",
      "required": ["protocol_version", "commit", "sha256"],
      "properties": {
        "protocol_version": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "path": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
