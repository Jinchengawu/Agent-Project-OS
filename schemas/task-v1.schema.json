{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-project-os.org/schemas/task-v1.schema.json",
  "title": "Agent Project OS task v1",
  "type": "object",
  "required": ["protocol_version", "task_id", "title", "status", "priority", "owner", "acceptance_criteria", "evidence_refs", "created_at", "updated_at"],
  "properties": {
    "$schema": {"type": "string"},
    "protocol_version": {"$ref": "common-v1.schema.json#/$defs/protocolVersion"},
    "task_id": {"$ref": "common-v1.schema.json#/$defs/id"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "status": {"enum": ["planned", "ready", "in_progress", "blocked", "waiting_review", "done", "paused", "cancelled"]},
    "priority": {"enum": ["low", "medium", "high", "urgent"]},
    "owner": {"type": "string", "minLength": 1},
    "acceptance_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "evidence_refs": {"type": "array", "items": {"$ref": "common-v1.schema.json#/$defs/id"}, "uniqueItems": true},
    "blocker": {
      "type": ["object", "null"],
      "properties": {"type": {"enum": ["dependency", "needs_input", "capability", "transient", "risk_gate"]}, "summary": {"type": "string"}},
      "required": ["type", "summary"],
      "additionalProperties": false
    },
    "created_at": {"$ref": "common-v1.schema.json#/$defs/timestamp"},
    "updated_at": {"$ref": "common-v1.schema.json#/$defs/timestamp"}
  },
  "additionalProperties": false
}
