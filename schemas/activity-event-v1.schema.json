{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-project-os.org/schemas/activity-event-v1.schema.json",
  "title": "Agent Project OS activity event v1",
  "type": "object",
  "required": ["protocol_version", "event_id", "event_type", "entity", "actor", "runtime_identity", "payload", "occurred_at"],
  "properties": {
    "$schema": {"type": "string"},
    "protocol_version": {"$ref": "common-v1.schema.json#/$defs/protocolVersion"},
    "event_id": {"$ref": "common-v1.schema.json#/$defs/id"},
    "event_type": {"type": "string", "minLength": 1},
    "entity": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {"type": {"type": "string", "minLength": 1}, "id": {"$ref": "common-v1.schema.json#/$defs/id"}},
      "additionalProperties": false
    },
    "actor": {"type": "string", "minLength": 1},
    "runtime_identity": {"$ref": "common-v1.schema.json#/$defs/runtimeIdentity"},
    "payload": {"type": "object"},
    "occurred_at": {"$ref": "common-v1.schema.json#/$defs/timestamp"}
  },
  "additionalProperties": false
}
